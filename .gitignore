
# ==========================================
# GXM-01 - Git Ignore Configuration
# ==========================================

# Python virtual environments
.venv/
venv/
env/

# Python cache files
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# Environment variables and local secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json

# Raw and processed datasets
data/raw/
data/processed/
datasets/

# Machine Learning model artifacts
models/
artifacts/
checkpoints/
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Experiment tracking
mlruns/
wandb/
lightning_logs/
runs/

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp

# macOS system files
.DS_Store

# VS Code local settings
.vscode/

# Build and distribution
build/
dist/
*.egg-info/

# Datasets
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

# Models
models/*
!models/.gitkeep